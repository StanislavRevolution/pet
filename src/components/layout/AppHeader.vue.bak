<template><v-app-bar app color="primary" elevation="2" rounded class="px-2"><v-app-bar-title class="font-weight-bold">Бизнес Платформа</v-app-bar-title><v-tabs v-model="activeTab" align-with-title centered color="white" slider-color="white" hide-slider height="64"><v-tab v-for="(item, index) in menuItems" :key="index" :value="item.route" :to="item.route" class="mx-1 text-body-1 font-weight-medium transition-swing rounded" style="min-width: auto">{{ item.title }}</v-tab></v-tabs><template v-slot:append><v-btn icon variant="text" class="ml-2"><v-icon>mdi-bell-outline</v-icon></v-btn><v-btn icon variant="text" class="ml-2"><v-icon>mdi-account-circle-outline</v-icon></v-btn></template></v-app-bar></template>
<script>export default {name: "AppHeader",data() {return {activeTab: this.$route.path.split("/")[1],menuItems: [{title: "Задачи", route: "/tasks"},{title: "Лидерборд", route: "/leaderboard"},{title: "Активность", route: "/activity"},{title: "Менторство", route: "/mentorship"},{title: "Карьера", route: "/career"}]}},watch: {"$route"(to) {this.activeTab = to.path.split("/")[1];}}};</script>
<style scoped>.v-tab {opacity: 0.8;transition: all 0.3s ease;}.v-tab:hover, .v-tab--selected {opacity: 1;background: rgba(255, 255, 255, 0.1);}.v-app-bar {backdrop-filter: blur(10px);border-bottom: 1px solid rgba(255, 255, 255, 0.1);}</style>
